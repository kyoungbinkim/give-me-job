# Saramin Job Search API
# https://oapi.saramin.co.kr/guide/job-search
SARAMIN_ACCESS_KEY=

# Work24 Open API
# Requires approved API access from Work24. You can also set WORK24_AUTH_KEY
# as an environment variable. API URLs are built into the tool by default.
WORK24_AUTH_KEY=

# JobKorea API
# Requires approved call URL issued by JobKorea.
JOBKOREA_API_URL=
